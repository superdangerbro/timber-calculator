# Postgres connection (Neon in prod; local Postgres 16 in dev)
DATABASE_URL=postgres://timber:timber@localhost:5432/timber
# Secret for signing session JWTs (>= 32 random chars). `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional: Mapbox token for satellite basemap (else Esri imagery / plain fallback)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: set to "1" to skip internet basemaps entirely (plain grid style)
NEXT_PUBLIC_OFFLINE_BASEMAP=
# Tests use a separate database
TEST_DATABASE_URL=postgres://timber:timber@localhost:5432/timber_test
